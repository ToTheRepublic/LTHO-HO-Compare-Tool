# WebSocket upgrade map for Streamlit
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# HTTPS for Root Domain (wydocsportal.com → county-landing.html)
server {
    listen 443 ssl;
    http2 on;
    server_name wydocsportal.com www.wydocsportal.com;

    client_max_body_size 500M;  # Increased for large PDFs
    client_body_timeout 300s;
    client_header_timeout 300s;
    send_timeout 300s;

    # SSL Certificate
    ssl_certificate /etc/letsencrypt/live/wydocsportal.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wydocsportal.com-0001/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Redirect www to non-www
    if ($host = 'www.wydocsportal.com') {
        return 301 https://wydocsportal.com$request_uri;
    }

    # Serve public-landing.html
    location / {
        root /var/www/html;
        index public-landing.html;
        try_files $uri $uri/ =404;
    }
}

# HTTPS for Subdomains (*.wydocsportal.com → proxy to Streamlit app)
server {
    listen 443 ssl;
    http2 on;
    
    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Match any subdomain and capture it
    server_name ~^(?<subdomain>.+)\.wydocsportal\.com$;

    client_max_body_size 500M;  # Large PDFs
    client_body_timeout 300s;   # 5min for uploads
    client_header_timeout 300s;
    send_timeout 300s;

    # SSL Certificate (you need a wildcard cert for *.wydocsportal.com)
    ssl_certificate /etc/letsencrypt/live/wydocsportal.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wydocsportal.com-0001/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Direct proxy to Streamlit app (no /search path needed)
    location / {
        proxy_pass http://0.0.0.0:8503;
        proxy_http_version 1.1;
        
        # Essential for Streamlit WebSockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # Pass the full subdomain to app for county detection
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Critical timeouts for Streamlit
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        
        # Handle large file uploads
        proxy_request_buffering off;
    }
}

# HTTP Redirect (Certbot-managed)
server {
    if ($host = www.wydocsportal.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = wydocsportal.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = 'wydocsportal.com') {
        return 301 https://$host$request_uri;
    }

    if ($host = 'www.wydocsportal.com') {
        return 301 https://wydocsportal.com$request_uri;
    }

    listen 80;
    server_name wydocsportal.com www.wydocsportal.com;
    return 404;
}